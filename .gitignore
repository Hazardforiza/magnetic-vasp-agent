.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
.env

# Runtime metadata and generated calculations
var/*
!var/.gitkeep
runs/

# Local LLM config (only the example is tracked; the real one is user-specific)
config/agent/llm.json

# Licensed VASP data and large calculation artifacts
POTCAR
POTCAR.*
# Git on Windows matches case-insensitively; keep the source package visible.
!src/**/potcar/
WAVECAR
CHGCAR
CHG
vasprun.xml
OUTCAR
# Keep the compact, trimmed post-processing test fixtures (not real bulk data).
!tests/fixtures/postprocess/**/OUTCAR
!tests/fixtures/postprocess/**/vasprun.xml

